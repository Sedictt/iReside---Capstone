        <mxCell id="landlord_source" value="&lt;b style=&quot;font-size: 16px;&quot;&gt;LANDLORD&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px; color: #64748b;&quot;&gt;Property Owner / Manager&lt;br&gt;[External Data Source]&lt;/font&gt;" style="whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0284c7;strokeWidth=1;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="228" y="123" width="284" height="79" as="geometry" />
