        </mxCell>

        <!-- LANDLORD SINK (GANE & SARSON DOUBLE SQUARE) -->
        <mxCell id="landlord_sink_outer" value="" style="whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#0284c7;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="220" y="975" width="300" height="95" as="geometry" />
        </mxCell>
        <mxCell id="landlord_sink" value="&lt;b style=&quot;font-size: 16px;&quot;&gt;LANDLORD&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px; color: #64748b;&quot;&gt;Property Owner / Manager&lt;br&gt;[External Data Sink]&lt;/font&gt;" style="whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0284c7;strokeWidth=1;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="228" y="983" width="284" height="79" as="geometry" />
        </mxCell>

        <!-- TENANT SINK (GANE & SARSON DOUBLE SQUARE) -->
        <mxCell id="tenant_sink_outer" value="" style="whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#0284c7;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1180" y="975" width="300" height="95" as="geometry" />
        </mxCell>
        <mxCell id="tenant_sink" value="&lt;b style=&quot;font-size: 16px;&quot;&gt;TENANT&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px; color: #64748b;&quot;&gt;Resident / Prospective Applicant&lt;br&gt;[External Data Sink]&lt;/font&gt;" style="whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0284c7;strokeWidth=1;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1188" y="983" width="284" height="79" as="geometry" />
        </mxCell>

        <!-- ============================================== -->
        <!-- INBOUND DATA FLOWS (TIER 1 -> TIER 2: DOWNWARD)-->
        <!-- ============================================== -->

        <!-- Landlord Inbound Flow -->
        <mxCell id="flow_in_landlord" value="&lt;b style=&quot;color: #047857;&quot;&gt;LANDLORD INBOUND DATA FLOWS&lt;/b&gt;&lt;br&gt;• 1. Auth Credentials &amp;amp; 2FA Setup [P1.0]&lt;br&gt;• 2. Property Setup &amp;amp; Unit Configurations [P2.0]&lt;br&gt;• 3. Floor Plan Blueprint &amp;amp; Grid Coordinates [P3.0]&lt;br&gt;• 4. Intake Invites &amp;amp; Screening Decisions [P4.0]&lt;br&gt;• 5. Lease Terms &amp;amp; Countersignatures [P5.0]&lt;br&gt;• 6. Meter Readings, Tariffs &amp;amp; Cash Records [P6.0]&lt;br&gt;• 7. Maintenance Work Orders &amp;amp; Expense Logs [P7.0]&lt;br&gt;• 8. Direct Chat &amp;amp; Broadcast Alerts [P8.0]&lt;br&gt;• 9. Community Bulletins &amp;amp; Amenity Approvals [P9.0]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;strokeColor=#059669;strokeWidth=2.5;fontSize=11;fontColor=#0f172a;align=left;labelBackgroundColor=#ecfdf5;labelBorderColor=#a7f3d0;" edge="1" parent="1" source="landlord_source_outer" target="process0">
          <mxGeometry x="-0.15" y="-35" relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="370" y="340" />
              <mxPoint x="450" y="340" />
              <mxPoint x="450" y="554" />
            </Array>
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>

        <!-- Tenant Inbound Flow -->
        <mxCell id="flow_in_tenant" value="&lt;b style=&quot;color: #047857;&quot;&gt;TENANT INBOUND DATA FLOWS&lt;/b&gt;&lt;br&gt;• 1. Auth Credentials &amp;amp; Profile Updates [P1.0]&lt;br&gt;• 2. Rental Application &amp;amp; KYC Proof Documents [P4.0]&lt;br&gt;• 3. Digital Signatures, Renewal &amp;amp; Move-Out Notices [P5.0]&lt;br&gt;• 4. GCash Payment Proofs &amp;amp; Reference IDs [P6.0]&lt;br&gt;• 5. Maintenance Service Claims &amp;amp; Photos [P7.0]&lt;br&gt;• 6. Direct Chat Inquiries &amp;amp; Messages [P8.0]&lt;br&gt;• 7. Community Comments, Poll Votes &amp;amp; Bookings [P9.0]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.25;entryDx=0;entryDy=0;strokeColor=#059669;strokeWidth=2.5;fontSize=11;fontColor=#0f172a;align=left;labelBackgroundColor=#ecfdf5;labelBorderColor=#a7f3d0;" edge="1" parent="1" source="tenant_source_outer" target="process0">
          <mxGeometry x="-0.15" y="35" relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1330" y="340" />
              <mxPoint x="1250" y="340" />
              <mxPoint x="1250" y="554" />
            </Array>
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>

        <!-- ============================================== -->
        <!-- OUTBOUND DATA FLOWS (TIER 2 -> TIER 3: DOWNWARD)-->
        <!-- ============================================== -->

        <!-- Landlord Outbound Flow -->
        <mxCell id="flow_out_landlord" value="&lt;b style=&quot;color: #0369a1;&quot;&gt;LANDLORD OUTBOUND DATA FLOWS&lt;/b&gt;&lt;br&gt;• 1. Authorized Session &amp;amp; Role Permissions [P1.0]&lt;br&gt;• 2. Property Portfolio &amp;amp; Unit Summaries [P2.0]&lt;br&gt;• 3. Rendered 2D Blueprint &amp;amp; Live Occupancy Map [P3.0]&lt;br&gt;• 4. Submitted Applications &amp;amp; KYC Files [P4.0]&lt;br&gt;• 5. Executed Contracts &amp;amp; Tenancy Requests [P5.0]&lt;br&gt;• 6. Payment Proofs, Ledgers &amp;amp; Official Receipts [P6.0]&lt;br&gt;• 7. Maintenance Tickets &amp;amp; Photo Evidence [P7.0]&lt;br&gt;• 8. Resident Messages &amp;amp; Delivery Receipts [P8.0]&lt;br&gt;• 9. Community Activity &amp;amp; Amenity Requests [P9.0]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#0284c7;strokeWidth=2.5;fontSize=11;fontColor=#0f172a;align=left;labelBackgroundColor=#f0f9ff;labelBorderColor=#bae6fd;" edge="1" parent="1" source="process0" target="landlord_sink_outer">
          <mxGeometry x="0.15" y="-35" relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="450" y="651" />
              <mxPoint x="450" y="850" />
              <mxPoint x="370" y="850" />
            </Array>
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>

        <!-- Tenant Outbound Flow -->
        <mxCell id="flow_out_tenant" value="&lt;b style=&quot;color: #0369a1;&quot;&gt;TENANT OUTBOUND DATA FLOWS&lt;/b&gt;&lt;br&gt;• 1. Authenticated Session &amp;amp; Portal Routing [P1.0]&lt;br&gt;• 2. Assigned Room Details &amp;amp; Guidelines [P2.0]&lt;br&gt;• 3. Spatial Floor Map &amp;amp; Building Blueprint [P3.0]&lt;br&gt;• 4. Application Decisions &amp;amp; Account Credentials [P4.0]&lt;br&gt;• 5. Signed Lease PDF &amp;amp; Countersignatures [P5.0]&lt;br&gt;• 6. Itemized Invoices &amp;amp; Official Receipts [P6.0]&lt;br&gt;• 7. Maintenance Ticket Status &amp;amp; Updates [P7.0]&lt;br&gt;• 8. Landlord Replies &amp;amp; Operational Alerts [P8.0]&lt;br&gt;• 9. Bulletins &amp;amp; Amenity Reservation Passes [P9.0]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#0284c7;strokeWidth=2.5;fontSize=11;fontColor=#0f172a;align=left;labelBackgroundColor=#f0f9ff;labelBorderColor=#bae6fd;" edge="1" parent="1" source="process0" target="tenant_sink_outer">
          <mxGeometry x="0.15" y="35" relative="1" as="geometry">
