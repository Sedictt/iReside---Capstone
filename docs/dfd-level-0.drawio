          <mxGeometry x="1188" y="123" width="284" height="79" as="geometry" />
        </mxCell>

        <!-- ============================================== -->
        <!-- TIER 2: SYSTEM BOUNDARY & CENTRAL PROCESS 0    -->
        <!-- ============================================== -->
        <mxCell id="tier2_label" value="TIER 2: SYSTEM BOUNDARY &amp;amp; CENTRAL PROCESS" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontStyle=1;fontFamily=Helvetica;fontColor=#64748b;letterSpacing=2;" vertex="1" parent="1">
          <mxGeometry x="600" y="475" width="500" height="20" as="geometry" />
        </mxCell>

        <!-- PROCESS 0 (GANE & SARSON ROUNDED RECTANGLE WITH ID HEADER) -->
        <mxCell id="process0" value="&lt;b style=&quot;font-size: 16px;&quot;&gt;0&lt;/b&gt;&lt;hr&gt;&lt;b style=&quot;font-size: 18px;&quot;&gt;iReside Property Management System&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px; color: #334155; line-height: 1.6;&quot;&gt;&lt;b&gt;Encapsulated Core Modules (P1.0 – P9.0):&lt;/b&gt;&lt;br&gt;P1.0 Authentication &amp;amp; Account • P2.0 Property &amp;amp; Unit Management&lt;br&gt;P3.0 Interactive Unit Map &amp;amp; Floor Planner • P4.0 Tenant Intake &amp;amp; Applications&lt;br&gt;P5.0 Lease Contract Management • P6.0 Billing &amp;amp; Payment Management&lt;br&gt;P7.0 Maintenance &amp;amp; Incident Management • P8.0 Communication &amp;amp; Real-Time Messaging&lt;br&gt;P9.0 Community Hub &amp;amp; Amenity Management&lt;/font&gt;" style="swimlane;html=1;startSize=32;rounded=1;arcSize=14;fillColor=#f8fafc;strokeColor=#4338ca;strokeWidth=3;fontFamily=Helvetica;fontSize=14;fontStyle=1;align=center;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="540" y="505" width="620" height="195" as="geometry" />
        </mxCell>

        <!-- ============================================== -->
        <!-- TIER 3: EXTERNAL DATA SINKS (RECIPIENTS)       -->
        <!-- ============================================== -->
        <mxCell id="tier3_label" value="TIER 3: EXTERNAL DATA SINKS (RECIPIENT ENTITIES)" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontStyle=1;fontFamily=Helvetica;fontColor=#64748b;letterSpacing=2;" vertex="1" parent="1">
