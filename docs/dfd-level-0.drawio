        <!-- ============================================== -->
        <!-- HEADER / TITLE BLOCK                           -->
        <!-- ============================================== -->
        <mxCell id="title" value="iReside Property Management System — Data Flow Diagram (DFD) Level 0&lt;br&gt;&lt;font style=&quot;font-size: 13px; font-weight: normal; color: #475569;&quot;&gt;Gane &amp;amp; Sarson Methodology • Hierarchical Downward Flow • Strictly Landlord &amp;amp; Tenant (No Admin)&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=1;fontFamily=Helvetica;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="350" y="25" width="1000" height="50" as="geometry" />
        </mxCell>

        <!-- ============================================== -->
        <!-- TIER 1: EXTERNAL DATA SOURCES (INITIATORS)     -->
        <!-- ============================================== -->
        <mxCell id="tier1_label" value="TIER 1: EXTERNAL DATA SOURCES (INITIATING ENTITIES)" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontStyle=1;fontFamily=Helvetica;fontColor=#64748b;letterSpacing=2;" vertex="1" parent="1">
